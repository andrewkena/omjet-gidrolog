{
    "fileType": "VehicleConfig",
    "version": 1,
    "constants": {
        "_rtlAltParamValueCurrentAltitude": 0,
        "_rtlLoitTimeParamValueDefault": 60,
        "_planeRtlAltParamValueCurrentAltitude": -1,
        "_planeRtlAltParamValueDefaultSpecified": 10000,
        "_planeFenceActionRtl": 1,
        "_planeFenceActionAutoLandOrRtl": 8
    },
    "params": {
        "_rtlAltIsMeters": {
            "name": "noremap.RTL_ALT_M",
            "existsOnly": true
        },
        "_rtlAltFact": "RTL_ALT_M",
        "_rtlLoitTimeFact": "RTL_LOIT_TIME",
        "_planeRtlAltFact": "RTL_ALTITUDE",
        "_fenceAction": "FENCE_ACTION",
        "_fenceEnable": "FENCE_ENABLE",
        "_fenceRetAlt": "FENCE_RET_ALT",
        "_fenceType": "FENCE_TYPE",
        "_armingCheck": "ARMING_CHECK",
        "_armingSkipCheck": "ARMING_SKIPCHK"
    },
    "bindings": {
        "_fenceEnabled": "_fenceEnable && _fenceEnable.rawValue !== 0",
        "_fenceActionIsRtl": "_fenceAction && (_fenceAction.rawValue === _planeFenceActionRtl || _fenceAction.rawValue === _planeFenceActionAutoLandOrRtl)",
        "_rtlAltParamValueDefaultSpecified": "(_rtlAltIsMeters ? 15 : 1500)"
    },
    "sections": [
        {
            "title": "Возврат",
            "keywords": [
                "rtl",
                "return home",
                "return to launch",
                "loiter",
                "land",
                "altitude"
            ],
            "image": "/qmlimages/ReturnToHomeAltitude.svg",
            "showWhen": "controller.vehicle.multiRotor",
            "controls": [
                {
                    "param": "RTL_ALT_M",
                    "label": "Возврат на заданной высоте:",
                    "control": "radiogroup",
                    "options": [
                        {
                            "label": "Возврат на текущей высоте",
                            "value": "_rtlAltParamValueCurrentAltitude",
                            "checked": "_rtlAltFact.value === _rtlAltParamValueCurrentAltitude"
                        },
                        {
                            "label": "Возврат на заданной высоте",
                            "value": "_rtlAltParamValueDefaultSpecified",
                            "checked": "_rtlAltFact.value !== _rtlAltParamValueCurrentAltitude"
                        }
                    ]
                },
                {
                    "param": "RTL_ALT_M",
                    "label": "Высота возврата",
                    "enableWhen": "_rtlAltFact && _rtlAltFact.value !== _rtlAltParamValueCurrentAltitude"
                },
                {
                    "param": "RTL_LOIT_TIME",
                    "label": "Ожидание над точкой возврата",
                    "control": "toggleCheckbox",
                    "toggleCheckbox": {
                        "checked": "_rtlLoitTimeFact.value > 0",
                        "onChecked": "_rtlLoitTimeFact.value = _rtlLoitTimeParamValueDefault",
                        "onUnchecked": "_rtlLoitTimeFact.value = 0"
                    }
                },
                {
                    "param": "RTL_LOIT_TIME",
                    "label": "Время ожидания",
                    "enableWhen": "_rtlLoitTimeFact && _rtlLoitTimeFact.value > 0"
                },
                {
                    "param": "RTL_ALT_FINAL_M",
                    "label": "Высота финального этапа посадки"
                },
                {
                    "param": "LAND_SPD_MS",
                    "label": "Скорость снижения на финальном этапе"
                }
            ]
        },
        {
            "title": "Возврат",
            "keywords": [
                "rtl",
                "return home",
                "return to launch",
                "loiter",
                "land",
                "altitude"
            ],
            "image": "/qmlimages/ReturnToHomeAltitude.svg",
            "showWhen": "controller.vehicle.fixedWing",
            "controls": [
                {
                    "param": "RTL_ALTITUDE",
                    "label": "Высота возврата:",
                    "optional": true,
                    "control": "radiogroup",
                    "options": [
                        {
                            "label": "Возврат на текущей высоте",
                            "value": "_planeRtlAltParamValueCurrentAltitude",
                            "checked": "_planeRtlAltFact && _planeRtlAltFact.value < 0"
                        },
                        {
                            "label": "Возврат на заданной высоте",
                            "value": "_planeRtlAltParamValueDefaultSpecified",
                            "checked": "_planeRtlAltFact && _planeRtlAltFact.value >= 0"
                        }
                    ]
                },
                {
                    "param": "RTL_ALTITUDE",
                    "label": "Высота возврата",
                    "optional": true,
                    "enableWhen": "_planeRtlAltFact && _planeRtlAltFact.value >= 0"
                },
                {
                    "param": "RTL_RADIUS",
                    "label": "Радиус удержания",
                    "optional": true
                },
                {
                    "control": "label",
                    "label": "0 — использовать WP_LOITER_RAD, отрицательное — против часовой стрелки",
                    "indent": true,
                    "smallFont": true
                },
                {
                    "param": "RTL_AUTOLAND",
                    "label": "Автопосадка после возврата",
                    "optional": true,
                    "control": "combobox"
                }
            ]
        },
        {
            "title": "Геозона",
            "keywords": [
                "geofence",
                "boundary",
                "fence",
                "containment",
                "rally",
                "breach",
                "radius",
                "inclusion",
                "exclusion"
            ],
            "showWhen": "controller.vehicle.multiRotor",
            "controls": [
                {
                    "param": "FENCE_ENABLE",
                    "label": "Включено",
                    "control": "checkbox"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Максимальная высота",
                    "control": "bitmaskCheckbox",
                    "bitMask": 1,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_ALT_MAX",
                    "label": "Максимальная высота",
                    "showWhen": "_fenceEnabled && _fenceType && (_fenceType.rawValue & 1)"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Минимальная высота",
                    "control": "bitmaskCheckbox",
                    "bitMask": 8,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_ALT_MIN",
                    "label": "Минимальная высота",
                    "optional": true,
                    "showWhen": "_fenceEnabled && _fenceType && (_fenceType.rawValue & 8)"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Круг с центром в точке возврата",
                    "control": "bitmaskCheckbox",
                    "bitMask": 2,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_RADIUS",
                    "label": "Радиус круга",
                    "showWhen": "_fenceEnabled && _fenceType && (_fenceType.rawValue & 2)"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Разрешённые/запрещённые круги и полигоны",
                    "control": "bitmaskCheckbox",
                    "bitMask": 4,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_MARGIN",
                    "label": "Запас до границы",
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_AUTOENABLE",
                    "label": "Автовключение",
                    "optional": true,
                    "control": "combobox",
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_ACTION",
                    "label": "Действие при нарушении",
                    "control": "combobox",
                    "showWhen": "_fenceEnabled"
                }
            ]
        },
        {
            "title": "Геозона",
            "keywords": [
                "geofence",
                "boundary",
                "fence",
                "containment",
                "rally",
                "breach",
                "radius",
                "inclusion",
                "exclusion"
            ],
            "showWhen": "controller.vehicle.fixedWing",
            "controls": [
                {
                    "param": "FENCE_ENABLE",
                    "label": "Включено",
                    "control": "checkbox"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Максимальная высота",
                    "control": "bitmaskCheckbox",
                    "bitMask": 1,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_ALT_MAX",
                    "label": "Максимальная высота",
                    "showWhen": "_fenceEnabled && _fenceType && (_fenceType.rawValue & 1)"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Минимальная высота",
                    "control": "bitmaskCheckbox",
                    "bitMask": 8,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_ALT_MIN",
                    "label": "Минимальная высота",
                    "optional": true,
                    "showWhen": "_fenceEnabled && _fenceType && (_fenceType.rawValue & 8)"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Круг с центром в точке возврата",
                    "control": "bitmaskCheckbox",
                    "bitMask": 2,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_RADIUS",
                    "label": "Радиус круга",
                    "showWhen": "_fenceEnabled && _fenceType && (_fenceType.rawValue & 2)"
                },
                {
                    "param": "FENCE_TYPE",
                    "label": "Разрешённые/запрещённые круги и полигоны",
                    "control": "bitmaskCheckbox",
                    "bitMask": 4,
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_MARGIN",
                    "label": "Запас до границы",
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_AUTOENABLE",
                    "label": "Автовключение",
                    "optional": true,
                    "control": "combobox",
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_ACTION",
                    "label": "Действие при нарушении",
                    "control": "combobox",
                    "showWhen": "_fenceEnabled"
                },
                {
                    "param": "FENCE_RET_ALT",
                    "label": "Своя высота возврата",
                    "optional": true,
                    "control": "toggleCheckbox",
                    "indent": true,
                    "showWhen": "_fenceEnabled && _fenceActionIsRtl",
                    "toggleCheckbox": {
                        "checked": "_fenceRetAlt && _fenceRetAlt.value > 0",
                        "onChecked": "_fenceRetAlt.value = (_planeRtlAltFact ? _planeRtlAltFact.value : 100)",
                        "onUnchecked": "_fenceRetAlt.value = 0"
                    }
                },
                {
                    "param": "FENCE_RET_ALT",
                    "label": "Высота возврата",
                    "optional": true,
                    "indent": true,
                    "showWhen": "_fenceEnabled && _fenceActionIsRtl && _fenceRetAlt && _fenceRetAlt.value > 0"
                },
                {
                    "param": "FENCE_RET_RALLY",
                    "label": "Возврат в ближайший резервный порт",
                    "optional": true,
                    "control": "checkbox",
                    "indent": true,
                    "showWhen": "_fenceEnabled && _fenceActionIsRtl"
                }
            ]
        },
        {
            "title": "Предстартовые проверки",
            "keywords": [
                "arming",
                "pre-arm",
                "preflight",
                "safety check"
            ],
            "controls": [
                {
                    "control": "label",
                    "label": "Внимание: пропуск предстартовых проверок может привести к потере управления судном.",
                    "warning": true
                },
                {
                    "param": "ARMING_CHECK",
                    "label": "Предстартовые проверки",
                    "control": "bitmask",
                    "optional": true,
                    "firstEntryIsAll": true,
                    "showWhen": "_armingCheck"
                },
                {
                    "param": "ARMING_SKIPCHK",
                    "label": "Пропускаемые проверки",
                    "control": "bitmask",
                    "optional": true,
                    "showWhen": "!_armingCheck && _armingSkipCheck"
                }
            ]
        }
    ]
}
