{
    "version": 1,
    "fileType": "SettingsUI",
    "groups": [
        {
            "component": "MapProviderSettings",
            "sectionName": "Поставщик карт",
            "keywords": [
                "map provider",
                "satellite",
                "terrain",
                "street",
                "hybrid",
                "google",
                "bing"
            ]
        },
        {
            "component": "OfflineMapSettings",
            "sectionName": "Офлайн-карты",
            "keywords": [
                "offline",
                "download",
                "cache",
                "tile set"
            ]
        },
        {
            "heading": "Свой адрес карты",
            "keywords": [
                "custom map",
                "wms",
                "tile url",
                "tile server"
            ],
            "headingDescription": "qsTr(\"Адрес с подстановками {x} {y} {z} или {zoom}\")",
            "controls": [
                {
                    "setting": "appSettings.customURL"
                }
            ]
        },
        {
            "heading": "Кэш тайлов",
            "keywords": [
                "cache",
                "disk size",
                "memory size",
                "tile cache"
            ],
            "controls": [
                {
                    "setting": "mapsSettings.maxCacheDiskSize"
                },
                {
                    "setting": "mapsSettings.maxCacheMemorySize"
                }
            ]
        }
    ]
}
