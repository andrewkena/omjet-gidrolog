{
    "version": 1,
    "fileType": "SettingsUI",
    "groups": [
        {
            "component": "NtripConnectionSettings",
            "sectionName": "Подключение",
            "keywords": [
                "ntrip",
                "rtk",
                "connection status",
                "corrections"
            ]
        },
        {
            "component": "NtripServerSettings",
            "sectionName": "Сервер",
            "keywords": [
                "ntrip server",
                "rtk",
                "caster",
                "host",
                "port",
                "username",
                "password",
                "mountpoint"
            ]
        },
        {
            "component": "NtripMountpointBrowser",
            "sectionName": "Точки подключения",
            "keywords": [
                "mountpoint",
                "browse",
                "stream"
            ]
        },
        {
            "heading": "Передача позиции GGA",
            "keywords": [
                "gga",
                "vrs",
                "nmea",
                "position",
                "network rtk",
                "ntrip"
            ],
            "controls": [
                {
                    "setting": "ntripSettings.ntripGgaPositionSource"
                },
                {
                    "setting": "ntripSettings.ntripGgaIntervalSec"
                }
            ]
        },
        {
            "heading": "Параметры",
            "keywords": [
                "rtcm",
                "whitelist",
                "message filter",
                "ntrip"
            ],
            "controls": [
                {
                    "setting": "ntripSettings.ntripWhitelist",
                    "placeholder": "напр. 1005,1077,1087"
                }
            ]
        },
        {
            "heading": "Пересылка NTRIP по UDP",
            "keywords": [
                "udp forward",
                "relay",
                "corrections forward",
                "rtcm"
            ],
            "controls": [
                {
                    "setting": "ntripSettings.ntripUdpForwardEnabled"
                },
                {
                    "setting": "ntripSettings.ntripUdpTargetAddress",
                    "enableWhen": "QGroundControl.settingsManager.ntripSettings.ntripUdpForwardEnabled.rawValue"
                },
                {
                    "setting": "ntripSettings.ntripUdpTargetPort",
                    "enableWhen": "QGroundControl.settingsManager.ntripSettings.ntripUdpForwardEnabled.rawValue"
                }
            ]
        },
        {
            "heading": "Приём RTCM по UDP",
            "showWhen": "QGroundControl.settingsManager.gpsCorrectionSettings.userVisible",
            "keywords": [
                "udp rtcm"
            ],
            "controls": [
                {
                    "setting": "gpsCorrectionSettings.rtcmUdpInputEnabled"
                },
                {
                    "setting": "gpsCorrectionSettings.rtcmUdpInputPort",
                    "enableWhen": "QGroundControl.settingsManager.gpsCorrectionSettings.rtcmUdpInputEnabled.rawValue"
                },
                {
                    "setting": "gpsCorrectionSettings.rtcmUdpValidate",
                    "enableWhen": "QGroundControl.settingsManager.gpsCorrectionSettings.rtcmUdpInputEnabled.rawValue"
                }
            ]
        },
        {
            "component": "CorrectionRoutingSettings",
            "sectionName": "Маршрутизация поправок",
            "showWhen": "QGroundControl.settingsManager.gpsCorrectionSettings.userVisible && (QGroundControl.settingsManager.gpsCorrectionSettings.correctionSource as SettingsFact).userVisible",
            "keywords": [
                "corrections",
                "rtcm",
                "source",
                "stream",
                "routing",
                "automatic"
            ]
        },
        {
            "component": "CorrectionDiagnostics",
            "sectionName": "Диагностика поправок",
            "showWhen": "QGroundControl.settingsManager.gpsCorrectionSettings.userVisible",
            "keywords": [
                "corrections",
                "rtcm",
                "diagnostics",
                "events",
                "queued",
                "written",
                "unconfirmed",
                "dropped"
            ]
        }
    ]
}
